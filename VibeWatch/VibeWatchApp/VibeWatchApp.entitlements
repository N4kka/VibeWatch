<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- SPEC v3 §9.4. Il dominio è un SEGNAPOSTO (non ancora deciso) e deve combaciare con
	     UniversalLinks.host — c'è un test che lo verifica (UniversalLinksTests). Il "?mode=developer"
	     qui non serve: si aggiunge solo per collaudare una AASA non ancora sulla CDN di Apple. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:vibewatch.app</string>
	</array>
</dict>
</plist>
