// FAQ Items
"profile.faq.question1" = "Comment les clips m'aident-ils à découvrir de nouveaux titres ?";
"profile.faq.answer1" = "Les clips sont de courtes prévisualisations verticales adaptées à vos goûts pour que vous puissiez défiler sans avoir l'impression de perdre votre temps.";
"profile.faq.question2" = "Puis-je suivre ce que je regarde ?";
"profile.faq.answer2" = "Oui. Enregistrez dans des listes, marquez comme vu/aimé/pas aimé et synchronisez entre films et séries.";
"profile.faq.question3" = "Où puis-je le regarder ?";
"profile.faq.answer3" = "Les liens streaming sont affichés par pays pour que vous puissiez aller directement à la bonne application.";
"profile.faq.question4" = "Et si quelque chose semble incorrect ?";
"profile.faq.answer4" = "Utilisez \"Faites-le nous savoir\" sur n'importe quel titre pour signaler des bugs ou liens cassés et nous les corrigerons rapidement.";
"profile.faq.question5" = "VibeWatch fonctionne-t-il pour les spectateurs occasionnels ?";
"profile.faq.answer5" = "Absolument. Nous proposons des choix faciles comme un film du samedi soir entre amis ainsi que des pépites pour les cinéphiles.";
