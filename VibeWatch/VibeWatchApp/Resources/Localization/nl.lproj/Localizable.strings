// FAQ Items
"profile.faq.question1" = "Hoe helpt Clips me nieuwe titels te ontdekken?";
"profile.faq.answer1" = "Clips zijn korte, verticale previews afgestemd op jouw smaak, zodat je kunt binge-scrollen zonder het gevoel dat je tijd verspilt.";
"profile.faq.question2" = "Kan ik bijhouden wat ik kijk?";
"profile.faq.answer2" = "Ja. Sla op in lijsten, markeer als gezien/leuk/niet leuk, en synchroniseer films en series.";
"profile.faq.question3" = "Waar kan ik het kijken?";
"profile.faq.answer3" = "Streaminglinks worden per land opgehaald zodat je direct naar de juiste app kunt springen.";
"profile.faq.question4" = "Wat als iets er niet goed uitziet?";
"profile.faq.answer4" = "Gebruik \"Laat het ons weten\" bij elke titel om bugs of slechte links te melden en we lossen het snel op.";
"profile.faq.question5" = "Werkt VibeWatch voor casual kijkers?";
"profile.faq.answer5" = "Absoluut. We tonen makkelijke keuzes zoals een zaterdagavondfilm met vrienden, maar ook diepgaande tips voor filmliefhebbers.";
