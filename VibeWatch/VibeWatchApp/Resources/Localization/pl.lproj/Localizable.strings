// Help & Support - About Us
"profile.aboutUsDescription" = "Jesteśmy dwójką przyjaciół, którzy tworzą nowy rodzaj towarzysza filmowego/serialowego. VibeWatch narodził się z frustracji niewygodnymi trackerami: skupiamy się na nowoczesnym odkrywaniu opartym na klipach, szybkich linkach do streamingu i narzędziach, które pomagają zarówno kinomaniakom, jak i zwykłym widzom znaleźć idealną pozycję bez niekończącego się scrollowania.";
"profile.faqs" = "FAQ";
"profile.legal" = "Prawne";

// FAQ Items
"profile.faq.question1" = "Jak Klipy pomagają mi odkrywać nowe tytuły?";
"profile.faq.answer1" = "Klipy to krótkie, pionowe podglądy dopasowane do Twojego gustu, dzięki czemu możesz scrollować bez poczucia marnowania czasu.";
"profile.faq.question2" = "Czy mogę śledzić co oglądam?";
"profile.faq.answer2" = "Tak. Zapisuj na listach, oznaczaj jako obejrzane/lubiane/nielubiane i synchronizuj filmy i seriale.";
"profile.faq.question3" = "Gdzie mogę to obejrzeć?";
"profile.faq.answer3" = "Linki do streamingu są pobierane dla każdego kraju, więc możesz przejść bezpośrednio do odpowiedniej aplikacji.";
"profile.faq.question4" = "Co jeśli coś wygląda źle?";
"profile.faq.answer4" = "Użyj \"Daj nam znać\" przy dowolnym tytule, aby zgłosić błędy lub złe linki, a my szybko to naprawimy.";
"profile.faq.question5" = "Czy VibeWatch działa dla zwykłych widzów?";
"profile.faq.answer5" = "Zdecydowanie. Pokazujemy łatwe wybory jak sobotnio-wieczorny film ze znajomymi, ale też perełki dla prawdziwych kinomaniaków.";
