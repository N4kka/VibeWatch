// Help & Support - About Us
"profile.aboutUsDescription" = "Wir sind zwei Freunde, die einen neuen Film-/Serien-Begleiter entwickeln. VibeWatch entstand aus Frustration mit umständlichen Trackern: Wir setzen auf moderne, clip-basierte Entdeckung, schnelle Streaming-Links und Tools, die sowohl Cineasten als auch Gelegenheitszuschauern helfen, ohne endloses Scrollen den perfekten Pick zu finden.";
"profile.faqs" = "FAQs";
"profile.legal" = "Rechtliches";

// FAQ Items
"profile.faq.question1" = "Wie helfen mir Clips, neue Titel zu entdecken?";
"profile.faq.answer1" = "Clips sind kurze, vertikale Vorschauen, die auf deinen Geschmack abgestimmt sind, sodass du scrollen kannst, ohne das Gefühl zu haben, Zeit zu verschwenden.";
"profile.faq.question2" = "Kann ich verfolgen, was ich schaue?";
"profile.faq.answer2" = "Ja. Speichere in Listen, markiere als gesehen/gefällt/gefällt nicht und synchronisiere über Filme und Serien.";
"profile.faq.question3" = "Wo kann ich es schauen?";
"profile.faq.answer3" = "Streaming-Links werden pro Land angezeigt, sodass du direkt zur richtigen App springen kannst.";
"profile.faq.question4" = "Was, wenn etwas falsch aussieht?";
