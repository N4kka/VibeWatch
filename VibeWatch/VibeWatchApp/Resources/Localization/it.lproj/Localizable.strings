// FAQ Items
"profile.faq.question1" = "Come mi aiutano i Clip a scoprire nuovi titoli?";
"profile.faq.answer1" = "I Clip sono brevi anteprime verticali abbinate ai tuoi gusti così puoi scorrere senza sentirti di perdere tempo.";
"profile.faq.question2" = "Posso tenere traccia di cosa guardo?";
"profile.faq.answer2" = "Sì. Salva nelle liste, segna come visto/piaciuto/non piaciuto e sincronizza tra film e serie TV.";
"profile.faq.question3" = "Dove posso guardarlo?";
"profile.faq.answer3" = "I link streaming sono mostrati per paese così puoi passare direttamente all'app giusta.";
"profile.faq.question4" = "E se qualcosa sembra sbagliato?";
"profile.faq.answer4" = "Usa \"Faccelo sapere\" su qualsiasi titolo per segnalare bug o link non funzionanti e lo risolveremo velocemente.";
"profile.faq.question5" = "VibeWatch funziona per gli spettatori occasionali?";
"profile.faq.answer5" = "Assolutamente. Mostriamo scelte facili come un film del sabato sera con gli amici oltre a chicche per i cinefili.";