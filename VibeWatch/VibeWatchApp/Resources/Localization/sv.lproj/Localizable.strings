// FAQ Items
"profile.faq.question1" = "Hur hjälper Clips mig att hitta nya titlar?";
"profile.faq.answer1" = "Klipp är korta, vertikala förhandsvisningar som matchar din smak så du kan scroll-bingea utan att känna att du slösar tid.";
"profile.faq.question2" = "Kan jag hålla koll på vad jag tittar på?";
"profile.faq.answer2" = "Ja. Spara till listor, markera som sett/tyckt om/inte tyckt om och synka över filmer och serier.";
"profile.faq.question3" = "Var kan jag se den?";
"profile.faq.answer3" = "Streaminglänkar hämtas per land så att du kan hoppa direkt in i rätt app.";
"profile.faq.question4" = "Vad om något ser fel ut?";
"profile.faq.answer4" = "Använd \"Hör av dig\" på valfri titel för att rapportera buggar eller dåliga länkar så fixar vi det snabbt.";
"profile.faq.question5" = "Fungerar VibeWatch för casual-tittare?";
"profile.faq.answer5" = "Absolut. Vi lyfter fram enkla val som en lördagsfilm med vänner samt djupdykningar för filmälskare.";