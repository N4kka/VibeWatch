// FAQ Items
"profile.faq.question1" = "Clips मुझे नए शीर्षक खोजने में कैसे मदद करता है?";
"profile.faq.answer1" = "क्लिप्स छोटे, वर्टिकल प्रीव्यू हैं जो आपकी पसंद से मेल खाते हैं, ताकि आप बिना समय बर्बाद महसूस किए स्क्रॉल कर सकें.";
"profile.faq.question2" = "क्या मैं जो देखता हूँ उसे ट्रैक कर सकता हूँ?";
"profile.faq.answer2" = "हाँ। सूचियों में सहेजें, देखा/पसंद/नापसंद के रूप में चिह्नित करें, और फ़िल्मों व शो में सिंक करें.";
"profile.faq.question3" = "मैं इसे कहाँ देख सकता हूँ?";
"profile.faq.answer3" = "स्ट्रीमिंग लिंक देश के आधार पर लाए जाते हैं ताकि आप सीधे सही ऐप में जा सकें.";
"profile.faq.question4" = "अगर कुछ गलत लगता है तो?";
"profile.faq.answer4" = "किसी भी शीर्षक पर \"हमें बताएं\" का उपयोग करें बग या गलत लिंक रिपोर्ट करने के लिए, हम इसे जल्दी ठीक करेंगे.";
"profile.faq.question5" = "क्या VibeWatch कैज़ुअल दर्शकों के लिए काम करता है?";
"profile.faq.answer5" = "बिल्कुल। हम आसान विकल्प दिखाते हैं, जैसे दोस्तों के साथ शनिवार रात की फ़िल्म, और साथ ही फ़िल्म प्रेमियों के लिए गहरे चयन.";
