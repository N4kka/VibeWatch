// FAQ Items
"profile.faq.question1" = "Klipler yeni içerik keşfetmeme nasıl yardımcı olur?";
"profile.faq.answer1" = "Klipler, zevkine uygun kısa, dikey önizlemelerdir, böylece zaman kaybettiğini hissetmeden kaydırabilirsin.";
"profile.faq.question2" = "İzlediklerimi takip edebilir miyim?";
"profile.faq.answer2" = "Evet. Listelere kaydet, izlendi/beğendim/beğenmedim olarak işaretle ve film ile dizileri senkronize et.";
"profile.faq.question3" = "Nerede izleyebilirim?";
"profile.faq.answer3" = "Yayın bağlantıları ülkeye göre çekilir, böylece doğrudan doğru uygulamaya geçebilirsin.";
"profile.faq.question4" = "Bir şey yanlış görünürse ne yapmalıyım?";
"profile.faq.answer4" = "Herhangi bir içerikte \"Bize bildir\" seçeneğini kullanarak hataları veya bozuk bağlantıları bildir, hızlıca düzeltelim.";
"profile.faq.question5" = "VibeWatch sıradan izleyiciler için de uygun mu?";
"profile.faq.answer5" = "Kesinlikle. Arkadaşlarla Cumartesi akşamı filmi gibi kolay seçimler ve sinema tutkunları için gizli hazineler sunuyoruz.";
