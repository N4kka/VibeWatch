// FAQ Items
"profile.faq.question1" = "Как клипы помогают открывать новые тайтлы?";
"profile.faq.answer1" = "Клипы — это короткие вертикальные превью, подобранные под ваш вкус, чтобы вы могли листать без ощущения потраченного времени.";
"profile.faq.question2" = "Могу ли я отслеживать просмотренное?";
"profile.faq.answer2" = "Да. Сохраняйте в списки, отмечайте как просмотрено/понравилось/не понравилось и синхронизируйте фильмы и сериалы.";
"profile.faq.question3" = "Где это можно посмотреть?";
"profile.faq.answer3" = "Ссылки на стриминг подбираются по вашей стране, чтобы вы сразу попали в нужное приложение.";
"profile.faq.question4" = "Что делать, если что-то выглядит неправильно?";
"profile.faq.answer4" = "Используйте «Сообщите нам» на любом тайтле, чтобы сообщить об ошибках или нерабочих ссылках — мы быстро исправим.";
"profile.faq.question5" = "Подходит ли VibeWatch для обычных зрителей?";
"profile.faq.answer5" = "Конечно. Мы показываем простые варианты вроде фильма на вечер с друзьями, а также редкие находки для киноманов.";
