// FAQ Items
"profile.faq.question1" = "Miten Clips auttaa löytämään uusia nimikkeitä?";
"profile.faq.answer1" = "Klipit ovat lyhyitä pystysuoria esikatseluja, jotka sopivat makuusi, joten voit selailla tuntematta tuhlaavasi aikaa.";
"profile.faq.question2" = "Voinko seurata mitä katson?";
"profile.faq.answer2" = "Kyllä. Tallenna listoihin, merkitse nähdyksi/tykätyksi/ei-tykätyksi ja synkronoi elokuvien ja sarjojen välillä.";
"profile.faq.question3" = "Missä voin katsoa sen?";
"profile.faq.answer3" = "Suoratoistolinkit haetaan maakohtaisesti, jotta pääset suoraan oikeaan sovellukseen.";
"profile.faq.question4" = "Entä jos jokin näyttää väärältä?";
"profile.faq.answer4" = "Käytä \"Kerro meille\" missä tahansa nimikkeessä ilmoittaaksesi bugeista tai huonoista linkeistä, niin korjaamme ne nopeasti.";
"profile.faq.question5" = "Toimiiko VibeWatch satunnaiskatsojille?";
"profile.faq.answer5" = "Ehdottomasti. Nostamme esiin helpot valinnat, kuten lauantai-illan elokuvan ystävien kanssa, sekä syvemmät helmet elokuvaharrastajille.";