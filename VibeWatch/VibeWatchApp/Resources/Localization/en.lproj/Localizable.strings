// FAQ Items
"profile.faq.question1" = "How does Clips help me discover new titles?";
"profile.faq.answer1" = "Clips are short, vertical previews matched to your taste so you can binge-scroll without feeling you're wasting time.";
"profile.faq.question2" = "Can I track what I watch?";
"profile.faq.answer2" = "Yes. Save to lists, mark as seen/liked/disliked, and sync across movie and TV titles.";
"profile.faq.question3" = "Where can I watch it?";
"profile.faq.answer3" = "Streaming links are pulled per-country so you can jump straight into the right app.";
"profile.faq.question4" = "What if something looks wrong?";
"profile.faq.answer4" = "Use \"Let us know\" on any title to report bugs or bad links and we'll fix it fast.";
"profile.faq.question5" = "Does VibeWatch work for casual viewers?";
"profile.faq.answer5" = "Totally. We surface easy picks like a Saturday-night movie with friends as well as deep cuts for movie lovers.";

