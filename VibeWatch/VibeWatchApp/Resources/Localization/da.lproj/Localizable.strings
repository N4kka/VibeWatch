// FAQ Items
"profile.faq.question1" = "Hvordan hjælper Clips mig med at finde nye titler?";
"profile.faq.answer1" = "Klip er korte, vertikale previews der matcher din smag, så du kan scroll-binge uden at føle du spilder tiden.";
"profile.faq.question2" = "Kan jeg holde styr på, hvad jeg ser?";
"profile.faq.answer2" = "Ja. Gem på lister, markér som set/kunne lide/kunne ikke lide, og synkroniser på tværs af film og serier.";
"profile.faq.question3" = "Hvor kan jeg se det?";
"profile.faq.answer3" = "Streaminglinks hentes per land, så du kan hoppe direkte ind i den rigtige app.";
"profile.faq.question4" = "Hvad hvis noget ser forkert ud?";
"profile.faq.answer4" = "Brug \"Giv os besked\" på enhver titel til at rapportere fejl eller dårlige links, så fikser vi det hurtigt.";
"profile.faq.question5" = "Virker VibeWatch for afslappede seere?";
"profile.faq.answer5" = "Helt sikkert. Vi viser både lette valg som en lørdagsfilm med venner og dybe nedslag for filmelskere.";
