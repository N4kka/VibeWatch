// FAQ Items
"profile.faq.question1" = "Como os clips me ajudam a descobrir novos títulos?";
"profile.faq.answer1" = "Clips são prévias curtas e verticais combinadas com seu gosto para que você possa rolar sem sentir que está perdendo tempo.";
"profile.faq.question2" = "Posso acompanhar o que assisto?";
"profile.faq.answer2" = "Sim. Salve em listas, marque como visto/gostei/não gostei e sincronize entre filmes e séries.";
"profile.faq.question3" = "Onde posso assistir?";
"profile.faq.answer3" = "Links de streaming são mostrados por país para que você possa ir direto para o app certo.";
"profile.faq.question4" = "E se algo parecer errado?";
"profile.faq.answer4" = "Use \"Conte para a gente\" em qualquer título para reportar bugs ou links quebrados e corrigiremos rapidamente.";
"profile.faq.question5" = "O VibeWatch funciona para espectadores casuais?";
"profile.faq.answer5" = "Totalmente. Mostramos escolhas fáceis como um filme de sábado à noite com amigos além de pérolas para cinéfilos.";
