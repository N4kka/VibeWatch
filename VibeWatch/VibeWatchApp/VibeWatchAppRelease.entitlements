<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- SPEC v3 §9.4. Il dominio deve combaciare con UniversalLinks.host — c'è un test che lo
	     verifica (UniversalLinksTests). Gli applinks distinguono i sottodomini, quindi apex e www
	     vanno dichiarati entrambi. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:vibewatchapp.com</string>
		<string>applinks:www.vibewatchapp.com</string>
	</array>
</dict>
</plist>
