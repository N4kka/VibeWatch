# Swift Package Manager
.swiftpm
.build/
Packages/
Package.pins
Package.resolved
# ...except the app's own lockfile. Ignoring Package.resolved is the convention for a
# library, whose consumers resolve their own graph. This is an App Store application:
# without the lockfile committed, a clean checkout re-resolves against the version ranges
# in the pbxproj and can build against different dependency versions than the ones shipped.
!VibeWatch/VibeWatchApp.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods
Pods/

# Carthage
Carthage/Checkouts
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
iOSInjectionProject/

# API Keys and Secrets (IMPORTANT!)
Config.swift
# ...but not the app's own Config.swift, which holds no secret VALUES: it only names the
# Info.plist keys to read (the values come from the untracked Secrets.xcconfig). It is
# required source, and excluding it means a clean checkout cannot build.
!VibeWatch/VibeWatchApp/Core/Network/Config.swift
APIKeys.plist
*.secret

# macOS
.DS_Store

# Temporary files
BUILD_FIX.md
TestApp.swift
generate_project.sh
open_xcode.sh

# Local tooling/projects
.claude/
ElevateYourMood/

# Il sito (repo git a sé, servito dal Worker su vibewatchapp.com — non fa parte dell'app).
# `vibewatch-site/` era il nome della cartella prima del cutover; la copia di lavoro oggi si
# chiama `VibeWatchWeb/`, e senza questa riga un `git add -A` se la porta dentro come gitlink:
# la radice di questo repo è la cartella che contiene entrambi i progetti.
vibewatch-site/
VibeWatchWeb/

# Stato locale della CLI Supabase: a quale progetto è agganciata questa copia e con quali
# versioni dei servizi. Cambia da sé a ogni comando, non è codice da condividere.
VibeWatch/supabase/supabase/.temp/
